# ============================================================================
# 51job-cli 环境变量配置模板
# ----------------------------------------------------------------------------
# 用法：
#   1. 用户级（推荐，默认加载）：cp .env.example ~/.51job-cli/.env  然后填写
#   2. 项目级（需显式开启）：cp .env.example .env，并设置系统环境变量 51JOB_PROJECT_ENV=1
#   优先级：系统环境变量 > 用户级 ~/.51job-cli/.env > 项目级 ./.env
#   （dotenv 默认不覆盖已存在的变量，先加载者优先）
# ============================================================================

# ---- 百度 OCR（简历识别；默认关闭，需显式 opt-in） --------------------------
# 简历截图含候选人个人信息，开启即表示同意把截图上传百度智能云识别（preview 命令）。
# 百度智能云控制台 → 产品服务 → 通用文字识别 → 应用列表
# https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
#51JOB_RESUME_OCR=1
#51JOB_BAIDU_API_KEY=
#51JOB_BAIDU_SECRET_KEY=
# 兼容兜底：未配置 51JOB_BAIDU_* 时使用通用名（与其他工具串扰风险，运行时会提示迁移）
#API_KEY=
#SECRET_KEY=

# ---- 浏览器 ----------------------------------------------------------------
# Chrome/Edge 可执行文件路径（未设置时自动探测系统 Chrome/Edge）
#CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 无头模式（默认 false——有头更安全，无头有封号风险）。两个变量等价，51JOB 优先。
# 旧名 RECRUIT_BROWSER_HIDDEN 仍兼容（本版本），后续移除。
#51JOB_BROWSER_HEADLESS=false
#RECRUIT_BROWSER_HEADLESS=false

# ---- 反检测 ----------------------------------------------------------------
# 恢复 console.clear 原始行为（默认对抗=替换为空函数）
#51JOB_BROWSER_ALLOW_CONSOLE_CLEAR=false
# 恢复完整 console 形态（保留对象树，但会被时间差检测命中）
#51JOB_BROWSER_ALLOW_VERBOSE_CONSOLE=false
# 完全不拦截风控/验证页导航（人工验证场景）
#51JOB_BROWSER_ALLOW_RISK_NAV=false
# 逗号分隔：拦截站点安全/风控脚本（Fetch.failRequest），探测到后启用（默认空=不拦）
#51JOB_BLOCK_SCRIPT_PATTERNS=
# 逗号分隔：拦截埋点上报并 204 吞掉。默认只「观察」记录到页面 console 后放行；
# 用 51job probe 校准确认埋点路径后再配置，避免误杀业务接口。
#51JOB_BLOCK_REPORT_PATTERNS=
# 页面 confirm/alert 弹窗自动处理（true=接受，false=关闭）
#51JOB_DIALOG_ACCEPT=true

# ---- 调试 ------------------------------------------------------------------
# 页面 console 消息转发到 CLI 输出（排查站点行为/聊天 SDK 日志）
#51JOB_PAGE_CONSOLE=1
# 人机确认（action/greet 不可逆操作）超时毫秒，超时按拒绝处理；<=0 关闭超时
#51JOB_CONFIRM_TIMEOUT_MS=300000

# ---- 节流 ------------------------------------------------------------------
# 操作间隔随机延迟（毫秒）。两个值=随机区间（推荐，如 800,2000）；一个值=固定间隔。
# 注意：不支持 800-2000 连字符写法（会被解析成固定 800，随机化失效）。
#51JOB_DELAY=800,2000

# ---- 可用性校验 ------------------------------------------------------------
# 强制刷新线上前端基线校验（跳过缓存）
#51JOB_AVAILABILITY_REFRESH=1
# 校验总超时毫秒（默认 30000；网络类失败只警告放行，不缓存禁用）
#51JOB_AVAILABILITY_TIMEOUT_MS=30000

# ---- 运维 / 隔离 -----------------------------------------------------------
# 项目级 .env 加载开关（默认不读当前目录 .env，防不可信目录配置注入）
#51JOB_PROJECT_ENV=1
# smoke 测试隔离钩子：覆盖 state.json 路径 / Chrome profile 目录（一般用户无需设置）
#51JOB_STATE_FILE=
#51JOB_USER_DATA_DIR=
# clean 命令保留天数（ocr/probe 生成物，默认 30；0=全部清理；--jd 才连带清理 jd）
#51JOB_RETENTION_DAYS=30
